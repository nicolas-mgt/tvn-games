  "host": {
    "intro": [
      "Witam w studiu! Trzy bramki, jedna nagroda. Która to będzie?",
      "Proszę państwa, oto nasze bramki! Wybieraj śmiało!",
      "Za jedną bramką czeka coś pięknego. Za dwiema… cóż, zobaczymy!"
    ],
    "opens": [
      "Wybrałeś nr {picked}. Ale zanim cokolwiek… otwórzmy bramkę nr {door}!",
      "Nr {picked}, dobrze. Dla podniesienia napięcia zajrzyjmy za bramkę nr {door}…"
    ],
    "offer": [
      "Za nr {door}: {item}! Zostajesz przy nr {picked}, zamieniasz czy bierzesz kopertę?",
      "Ha! {item} za nr {door}. Mam tu kopertę z gotówką. Grasz dalej?"
    ],
    "reveal": [
      "Werble, proszę! Otwieramy bramkę nr {door}…",
      "Decyzja zapadła. Bramka nr {door}, pokaż się!"
    ],
    "prize": [
      "Brawo! {item} jedzie do ciebie!",
      "Gratulacje! Wygrywasz: {item}!"
    ],
    "zonk": [
      "ZONK! Za bramką: {item}. Ale pamiątka jest!",
      "Ojej… {item}. Głowa do góry, następna runda!"
    ],
    "cash": [
      "Pewna kasa to pewna kasa! Zobaczmy, co cię ominęło…",
      "Gotówka w kieszeni! A za bramkami było…"
    ]
  }
