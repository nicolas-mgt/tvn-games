{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "tvn-games",
        "namespace": "tvn-games"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "tvn-games"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "tvn-games"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "imagePullSecrets": [
              {
                "name": "ghcr"
              }
            ],
            "containers": [
              {
                "name": "web",
                "image": "$IMAGE",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/tvn-games/",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/tvn-games/",
                    "port": "http"
                  },
                  "periodSeconds": 20
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "tvn-games",
        "namespace": "tvn-games"
      },
      "spec": {
        "selector": {
          "app": "tvn-games"
        },
        "ports": [
          {
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "tvn-games",
        "namespace": "tvn-games",
        "annotations": {
          "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
          "traefik.ingress.kubernetes.io/router.tls": "true",
          "traefik.ingress.kubernetes.io/router.tls.certresolver": "production"
        }
      },
      "spec": {
        "ingressClassName": "traefik",
        "tls": [
          {
            "hosts": [
              "home.mmgt.dev"
            ]
          }
        ],
        "rules": [
          {
            "host": "home.mmgt.dev",
            "http": {
              "paths": [
                {
                  "path": "/tvn-games",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "tvn-games",
                      "port": {
                        "number": 80
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "ci-deploy",
        "namespace": "tvn-games"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "type": "kubernetes.io/service-account-token",
      "metadata": {
        "name": "ci-deploy-token",
        "namespace": "tvn-games",
        "annotations": {
          "kubernetes.io/service-account.name": "ci-deploy"
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "ci-deploy",
        "namespace": "tvn-games"
      },
      "rules": [
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "resourceNames": [
            "tvn-games"
          ],
          "verbs": [
            "get",
            "patch",
            "watch"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments",
            "replicasets"
          ],
          "verbs": [
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "ci-deploy",
        "namespace": "tvn-games"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "ci-deploy"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "ci-deploy",
          "namespace": "tvn-games"
        }
      ]
    }
  ]
}
