{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	encode zstd gzip
	redir /tvn-games /tvn-games/ 308

	handle_path /tvn-games/* {
		root * /srv
		@pages path / /gra/*
		handle @pages {
			route {
				try_files {path} /index.html
				header Cache-Control "no-cache"
				file_server
			}
		}
		handle {
			file_server
		}
	}
	handle {
		respond 404
	}
}
